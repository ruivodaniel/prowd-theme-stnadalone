{
 "kind": "component",
 "schemaVersion": 1,
 "name": "result-picker",
 "version": 1,
 "surface": "web",
 "root": {
  "type": "Stack",
  "props": {
   "dir": "col",
   "gap": 24,
   "pad": 24
  },
  "children": [
   {
    "type": "Stack",
    "props": {
     "dir": "col",
     "gap": 12
    },
    "children": [
     {
      "type": "Text",
      "props": {
       "as": "p",
       "element": "type--body-extra-small",
       "emphasis": "quiet",
       "children": "#1 · Pass / Fail — a two-way ButtonGroup, each Button carrying its own status; the chosen one is emphasis='primary' + state='selected', the other stays 'secondary'"
      }
     },
     {
      "type": "Stack",
      "props": {
       "dir": "row",
       "gap": 12,
       "wrap": true,
       "align": "center"
      },
      "children": [
       {
        "type": "Stack",
        "props": {
         "dir": "col",
         "gap": 8,
         "align": "start"
        },
        "children": [
         {
          "type": "ButtonGroup",
          "props": {
           "scale": "lg",
           "className": "w-full max-w-sm"
          },
          "children": [
           {
            "type": "Button",
            "props": {
             "children": "Pass",
             "fill": true,
             "status": "success",
             "emphasis": "secondary",
             "startIcon": "check",
             "data-testid": "mark-pass"
            }
           },
           {
            "type": "Button",
            "props": {
             "children": "Fail",
             "fill": true,
             "status": "error",
             "emphasis": "secondary",
             "startIcon": "close",
             "data-testid": "mark-fail"
            }
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "Stack",
    "props": {
     "dir": "col",
     "gap": 12
    },
    "children": [
     {
      "type": "Text",
      "props": {
       "as": "p",
       "element": "type--body-extra-small",
       "emphasis": "quiet",
       "children": "#2 · Pass / Note / Flag — the three-way variant (test-run-run's actual choice set), same recipe at scale='md'"
      }
     },
     {
      "type": "Stack",
      "props": {
       "dir": "row",
       "gap": 12,
       "wrap": true,
       "align": "center"
      },
      "children": [
       {
        "type": "Stack",
        "props": {
         "dir": "col",
         "gap": 8,
         "align": "start"
        },
        "children": [
         {
          "type": "ButtonGroup",
          "props": {
           "scale": "md",
           "className": "w-full max-w-md"
          },
          "children": [
           {
            "type": "Button",
            "props": {
             "children": "Pass",
             "fill": true,
             "status": "success",
             "emphasis": "primary",
             "state": "selected",
             "startIcon": "check",
             "data-testid": "mark-pass"
            }
           },
           {
            "type": "Button",
            "props": {
             "children": "Note",
             "fill": true,
             "status": "info",
             "emphasis": "secondary",
             "startIcon": "message",
             "data-testid": "mark-note"
            }
           },
           {
            "type": "Button",
            "props": {
             "children": "Flag",
             "fill": true,
             "status": "warning",
             "emphasis": "secondary",
             "startIcon": "warning",
             "data-testid": "mark-flag"
            }
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
}
