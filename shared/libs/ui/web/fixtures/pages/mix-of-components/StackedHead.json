       }
      }
     },
     {
      "type": "Text",
      "props": {
       "as": "span",
       "element": "type--body-extra-small",
       "emphasis": "quiet",
       "children": {
        "bind": "unit"
       }
      }
     }
    ]
   }
  ]
 }
}